---
import BaseHead from "../components/layout/Metadata.astro";
import Footer from "../components/layout/Footer.astro";
import TopHeader from "../components/layout/TopHeader.astro";
import grainTexture from "../assets/grain_texture.webp";

const { title, description, image } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image}/>
	</head>

	<body style={`--grain-url: url('${grainTexture.src}')`}>
		<TopHeader title="MARTIN ROBLES" date="2026" subtitle="full stack developer"/>
		<slot />
		<Footer />
	</body>
</html>
