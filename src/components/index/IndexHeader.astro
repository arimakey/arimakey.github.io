---
import TextureFilter from "../TextureFilter.astro";
---

<header class="header">
    <div class="header__description">
        <article class="header__description__about">
            <p>Full Stack Developer con experiencia en aplicaciones web y plataformas SaaS, utilizando React, Vue.js, Node.js, TypeScript y PostgreSQL. He participado en proyectos de inteligencia artificial, integrando LLMs, automatizacion y APIs escalables. Disfruto construir productos desde cero y colaborar en equipos multidisciplinarios.</p>
        </article>
        <div class="header__description__social">
            <a href="https://linkedin.com/in/mroblesrp" class="large__button" target="_blank">
                <ion-icon name="logo-linkedin"></ion-icon>
                LinkedIn
            </a>
            <a href="https://github.com/arimakey" class="large__button large__button--transparent" target="_blank">
                <ion-icon name="logo-github"></ion-icon>
                Github
            </a>
        </div>
    </div>     
</header>

<style>
    .header {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .header__image {
        height: 12rem;
    }

    .header__description {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2rem;
    }

    .header__description__social {
        width: 64rem;
        display: flex;
        flex-direction: row;
        gap: 12px;
        width: 100%;
    }

    p {
        font-size: 16px;
        padding-right: 0rem;
        line-height: 1.5;
        color: var(--secundary-text);
    }

    @media only screen and (min-width: 480px) {
        .header__description {
            gap: 1rem;
        }

        .header__description__social {
            width: 100%;
            flex-direction: column;
        }

        p {
            font-size: 18px;
            padding-right: 1rem;
        }
    }

    @media only screen and (min-width: 768px) {
        .header__description__social {
            min-width: 15rem;
            max-width: 15rem;
        }

        .header__description {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
        }
    }
</style>