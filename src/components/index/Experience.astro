---
const companies = [
	{ name: "RapidBoard", role: "Full Stack Dev", color: "#D13842", location: "Lima, Peru", date: "Jan 2026 — Present",
		bullets: [
			"Desarrollo en Go de una librería de orquestación de agentes, integrando renderizado condicional en el frontend.",
			"Diseño de arquitectura backend multitenant con sistema RBAC para gestión de usuarios y permisos.",
			"Liderazgo del equipo de desarrollo con metodologías ágiles, code reviews y entregas continuas.",
		] },
	{ name: "Hackmetrix", role: "Full Stack Dev L2", color: "#CC4B2C", location: "Remote", date: "Aug 2025 — Jan 2026",
		bullets: [
			"React y NestJS sobre microservicios. Migración progresiva del frontend de Vue.js a React.",
			"Migración del sitio corporativo a Astro, mejorando rendimiento, SEO y mantenibilidad.",
			"Iniciativas de IA y documentación inicial de arquitectura basada en Apache Kafka.",
		] },
	{ name: "Hackmetrix", role: "Technology Intern", color: "#CC4B2C", location: "Remote", date: "Feb 2025 — Jul 2025",
		bullets: [
			"Vue.js y NestJS sobre microservicios. Refactorización y pruebas para reducir deuda técnica.",
			"Desarrollo del Test de Phishing con el equipo de Marketing para campañas de concientización.",
		] },
	{ name: "Cirvos", role: "Freelance Developer", color: "#5E3C72", location: "", date: "Sep 2025",
		bullets: [
			"Bots de WhatsApp con n8n, integrando Meta Business y WhatsApp Business API.",
			"Despliegue de Chatwoot como plataforma de atención al cliente multicanal.",
		] },
]
---

<section class="experience" id="experience">
	<h2 class="section-title">Experience</h2>

	<div class="ex-grid">
		{companies.map((c, i) => (
			<article class="ex-card" style="--accent:{c.color};--i:{i}" data-i={i}>
				<div class="ex-bar" style="background:{c.color}"></div>
				<div class="ex-body">
					<div class="ex-head">
						<h3>{c.role}</h3>
						<span class="ex-date">{c.date}</span>
					</div>
					<p class="ex-company">{c.name}{c.location ? ` · ${c.location}` : ''}</p>
					<ul class="ex-bullets">
						{c.bullets.map(b => <li>{b}</li>)}
					</ul>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.section-title {
		font-size: 2.8rem;
		text-transform: uppercase;
		letter-spacing: 0.3rem;
		color: var(--primary-color);
		border-bottom: 4px solid var(--primary-color);
		padding-bottom: 0.3rem;
		margin-bottom: 2.5rem;
		width: fit-content;
	}

	.ex-grid {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.ex-card {
		display: flex;
		background: var(--third-color);
		border: 2px solid var(--primary-color);
		box-shadow: 6px 6px 0 var(--primary-color);
		overflow: hidden;
		animation: exSlideUp 0.5s ease both;
		animation-delay: calc(var(--i) * 0.12s);
	}

	.ex-bar {
		width: 0.5rem;
		flex-shrink: 0;
	}

	.ex-body {
		padding: 1rem 1.2rem;
		flex: 1;
	}

	.ex-head {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		margin-bottom: 0.15rem;
	}

	.ex-head h3 {
		font-size: 1.3rem;
		color: var(--primary-text);
		letter-spacing: 0;
		margin: 0;
	}

	.ex-date {
		font-family: "Rosario", sans-serif;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.1rem;
	}

	.ex-company {
		font-family: "Rosario", sans-serif;
		font-size: 1rem;
		font-weight: 600;
		color: var(--secundary-text);
		margin-bottom: 0.4rem;
	}

	.ex-bullets {
		margin: 0;
		padding-left: 1.1rem;
	}

	.ex-bullets li {
		font-family: "Rosario", sans-serif;
		font-size: 0.85rem;
		margin-bottom: 0.15rem;
		line-height: 1.4;
		color: var(--secundary-text);
	}

	@keyframes exSlideUp {
		from {
			opacity: 0;
			transform: translateY(2rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ex-card {
			animation: none;
		}
	}

	@media only screen and (min-width: 480px) {
		.section-title {
			font-size: 3.5rem;
		}

		.ex-head h3 {
			font-size: 1.5rem;
		}

		.ex-body {
			padding: 1.2rem 1.5rem;
		}
	}

	@media only screen and (min-width: 768px) {
		.section-title {
			font-size: 4rem;
		}

		.ex-head {
			flex-direction: row;
			justify-content: space-between;
			align-items: baseline;
		}

		.ex-head h3 {
			font-size: 1.7rem;
		}

		.ex-bar {
			width: 0.6rem;
		}

		.ex-body {
			padding: 1.4rem 2rem;
		}
	}
</style>
