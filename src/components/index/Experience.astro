---
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/')

const companies = [
	{ logo: BASE + "companies/rapidboard-logo.png", role: "Full Stack Dev", name: "RapidBoard · Lima, Peru", date: "Jan 2026 — Present",
		url: "https://rapidboard.app/",
		bullets: [
			"Desarrollo en Go de una librería de orquestación de agentes, integrando renderizado condicional en el frontend.",
			"Diseño de arquitectura backend multitenant con sistema RBAC para gestión de usuarios y permisos.",
			"Liderazgo del equipo de desarrollo con metodologías ágiles, code reviews y entregas continuas.",
		] },
	{ logo: BASE + "companies/Hackmetrix.jpg", role: "Full Stack Dev L2", name: "Hackmetrix · Remote", date: "Aug 2025 — Jan 2026",
		url: "https://hackmetrix.com/",
		bullets: [
			"React y NestJS sobre microservicios. Migración progresiva del frontend de Vue.js a React.",
			"Migración del sitio corporativo a Astro, mejorando rendimiento, SEO y mantenibilidad.",
			"Iniciativas de IA y documentación inicial de arquitectura basada en Apache Kafka.",
		] },
	{ logo: BASE + "companies/Hackmetrix.jpg", role: "Technology Intern", name: "Hackmetrix · Remote", date: "Feb 2025 — Jul 2025",
		url: "https://hackmetrix.com/",
		bullets: [
			"Vue.js y NestJS sobre microservicios. Refactorización y pruebas para reducir deuda técnica.",
			"Desarrollo del Test de Phishing con el equipo de Marketing para campañas de concientización.",
		] },
	{ logo: BASE + "companies/Cirvos.png", role: "Freelance Developer", name: "Cirvos", date: "Sep 2025",
		bullets: [
			"Bots de WhatsApp con n8n, integrando Meta Business y WhatsApp Business API.",
			"Despliegue de Chatwoot como plataforma de atención al cliente multicanal.",
		] },
]
---

<section class="experience" id="experience">
	<h2 class="section-title">Experience</h2>

	<div class="timeline">
		{companies.map((c, i) => (
			<div class="tl-item" data-i={i} style={{ '--i': i }}>
				<div class="tl-badge">
					<img src={c.logo} alt="" />
					{c.url ? (
						<a class="tl-badge-overlay" href={c.url} target="_blank" rel="noopener" title="Visit website">
							<svg viewBox="0 0 24 24"><path fill="currentColor" d="M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3zm5 13v5H5V7h5V5H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5z"/></svg>
						</a>
					) : (
						<button class="tl-badge-overlay tl-badge-no-url" data-noweb title="No website available">
							<svg viewBox="0 0 24 24"><path fill="currentColor" d="M10.59 13.41c.41.39.41 1.03 0 1.42c-.39.39-1.03.39-1.42 0a5 5 0 0 1 0-7.07l3.54-3.54a5 5 0 0 1 7.07 0a5 5 0 0 1 0 7.07l-1.49 1.49c.01-.82-.12-1.64-.4-2.42l.47-.48a3 3 0 0 0 0-4.24a3 3 0 0 0-4.24 0l-3.53 3.53a3 3 0 0 0 0 4.24M2.29 7.15a6 6 0 0 0 0 8.49l.47.48c-.28-.78-.41-1.6-.4-2.42L.87 15.19a5 5 0 0 1 0-7.07l3.54-3.54a5 5 0 0 1 7.07 0a5 5 0 0 1 0 7.07l-1.49 1.49c.01-.82-.12-1.64-.4-2.43l.47-.47a3 3 0 0 0 0-4.24a3 3 0 0 0-4.24 0z"/></svg>
						</button>
					)}
				</div>
				<div class="tl-body">
					<div class="tl-head">
						<h3>{c.role}</h3>
						<span class="tl-date">{c.date}</span>
					</div>
					<p class="tl-company">{c.name}</p>
					<ul class="tl-bullets">
						{c.bullets.map(b => <li>{b}</li>)}
					</ul>
				</div>
			</div>
		))}
	</div>
	<dialog id="exp-dialog" class="exp-dialog">
		<div class="exp-dlg-inner">
			<button class="exp-dlg-close">&times;</button>
			<p>No website available for this company.</p>
		</div>
	</dialog>
</section>

<script>
	(function() {
		const dialog = document.getElementById('exp-dialog');
		const closeBtn = dialog.querySelector('.exp-dlg-close');

		document.addEventListener('click', (e) => {
			const btn = e.target.closest('.tl-badge-no-url');
			if (!btn) return;
			e.preventDefault();
			dialog.showModal();
		});

		closeBtn.addEventListener('click', () => dialog.close());
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});
	})();
</script>

<style>
	.section-title {
		margin-bottom: 1.5rem;
		color: var(--contrast-text);
		background-color: var(--primary-color);
		font-size: 1rem;
		text-align: center;
		padding: 0.5rem 1rem;
	}

	@media only screen and (min-width: 540px) {
		.section-title {
			font-size: 1.5rem;
			width: 100%;
		}
	}

	@media only screen and (min-width: 768px) {
		.section-title {
			padding: 0.8rem;
			width: 60%;
			font-size: 1.5rem;
		}
	}

	.timeline {
		position: relative;
		padding-left: 4rem;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 2rem;
		top: 0;
		bottom: 0;
		width: 3px;
		background: var(--primary-color);
		opacity: 0.3;
	}

	.tl-item {
		position: relative;
		margin-bottom: 2.5rem;
		animation: tlSlideUp 0.5s ease both;
		animation-delay: calc(var(--i) * 0.12s);
	}

	.tl-badge {
		position: absolute;
		left: -4rem;
		top: 0;
		width: 3.2rem;
		height: 3.2rem;
		z-index: 1;
		box-shadow: 4px 4px 0 var(--primary-color);
		overflow: hidden;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.tl-badge:hover {
		transform: scale(1.15);
		box-shadow: 8px 8px 0 var(--primary-color);
	}

	.tl-badge::before {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image: var(--grain-url);
		background-repeat: repeat;
		background-position: center;
		background-size: auto;
		pointer-events: none;
		content: '';
		mix-blend-mode: soft-light;
		opacity: 40%;
		z-index: 2;
	}

	.tl-badge::after {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		content: '';
		background-color: var(--secundary-text);
		mix-blend-mode: color;
		z-index: 1;
	}

	.tl-badge img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.tl-badge-overlay {
		position: absolute;
		inset: 0;
		z-index: 3;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 0, 0, 0.55);
		color: #fff;
		opacity: 0;
		transition: opacity 0.2s ease;
		border: none;
		cursor: pointer;
		text-decoration: none;
	}

	.tl-badge-overlay svg {
		width: 1.2rem;
		height: 1.2rem;
	}

	.tl-badge:hover .tl-badge-overlay {
		opacity: 1;
	}

	.tl-body {
		background: var(--third-color);
		padding: 1rem 1.5rem;
		border: 2px solid var(--primary-color);
		box-shadow: 6px 6px 0 var(--primary-color);
	}

	.tl-head {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin-bottom: 0.2rem;
	}

	.tl-head h3 {
		font-size: 1.4rem;
		color: var(--primary-text);
		letter-spacing: 0;
		margin: 0;
	}

	.tl-date {
		font-family: "Rosario", sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--primary-color);
		text-transform: uppercase;
		letter-spacing: 0.1rem;
	}

	.tl-company {
		font-family: "Rosario", sans-serif;
		font-size: 1rem;
		font-weight: 600;
		color: var(--secundary-text);
		margin-bottom: 0.5rem;
	}

	.tl-bullets {
		margin: 0;
		padding-left: 1.2rem;
	}

	.tl-bullets li {
		font-family: "Rosario", sans-serif;
		font-size: 0.9rem;
		margin-bottom: 0.2rem;
		line-height: 1.4;
		color: var(--secundary-text);
	}

	@keyframes tlSlideUp {
		from {
			opacity: 0;
			transform: translateY(2rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tl-item {
			animation: none;
		}
	}

	@media only screen and (min-width: 480px) {
		.tl-head h3 {
			font-size: 1.6rem;
		}

		.tl-badge {
			width: 3.6rem;
			height: 3.6rem;
		}

		.timeline {
			padding-left: 4.5rem;
		}

		.tl-badge {
			left: -4.5rem;
		}
	}

	@media only screen and (min-width: 768px) {
		.tl-head {
			flex-direction: row;
			justify-content: space-between;
			align-items: baseline;
		}

		.tl-head h3 {
			font-size: 1.8rem;
		}

		.tl-body {
			padding: 1.2rem 2rem;
		}

		.tl-badge {
			width: 4rem;
			height: 4rem;
		}

		.timeline {
			padding-left: 5rem;
		}

		.tl-badge {
			left: -5rem;
		}
	}

	.exp-dialog {
		border: 3px solid var(--primary-color);
		background: var(--secundary-color);
		padding: 0;
		margin: auto;
		max-width: 18rem;
		width: 90%;
		box-shadow: 8px 8px 0 var(--primary-color);
	}

	.exp-dialog[open] {
		animation: expDlgIn 0.2s ease;
	}

	@keyframes expDlgIn {
		from { opacity: 0; }
	}

	.exp-dialog::backdrop {
		background: rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(2px);
	}

	.exp-dlg-inner {
		position: relative;
		padding: 1.5rem;
		text-align: center;
	}

	.exp-dlg-close {
		position: absolute;
		top: 0.2rem;
		right: 0.5rem;
		background: none;
		border: none;
		color: var(--primary-color);
		font-size: 1.8rem;
		cursor: pointer;
		line-height: 1;
	}

	.exp-dlg-close:hover {
		opacity: 0.7;
	}

	.exp-dlg-inner p {
		font-family: "M PLUS Rounded 1c", sans-serif;
		font-weight: 900;
		font-size: 1rem;
		color: var(--primary-color);
		margin: 0;
	}
</style>
