---
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/')

const companies = [
	{ logo: BASE + "companies/rapidboard-logo.png", role: "Full Stack Dev", name: "RapidBoard · Lima, Peru", date: "Jan 2026 — Present",
		bullets: [
			"Desarrollo en Go de una librería de orquestación de agentes, integrando renderizado condicional en el frontend.",
			"Diseño de arquitectura backend multitenant con sistema RBAC para gestión de usuarios y permisos.",
			"Liderazgo del equipo de desarrollo con metodologías ágiles, code reviews y entregas continuas.",
		] },
	{ logo: BASE + "companies/Hackmetrix.jpg", role: "Full Stack Dev L2", name: "Hackmetrix · Remote", date: "Aug 2025 — Jan 2026",
		bullets: [
			"React y NestJS sobre microservicios. Migración progresiva del frontend de Vue.js a React.",
			"Migración del sitio corporativo a Astro, mejorando rendimiento, SEO y mantenibilidad.",
			"Iniciativas de IA y documentación inicial de arquitectura basada en Apache Kafka.",
		] },
	{ logo: BASE + "companies/Hackmetrix.jpg", role: "Technology Intern", name: "Hackmetrix · Remote", date: "Feb 2025 — Jul 2025",
		bullets: [
			"Vue.js y NestJS sobre microservicios. Refactorización y pruebas para reducir deuda técnica.",
			"Desarrollo del Test de Phishing con el equipo de Marketing para campañas de concientización.",
		] },
	{ logo: BASE + "companies/Cirvos.png", role: "Freelance Developer", name: "Cirvos", date: "Sep 2025",
		bullets: [
			"Bots de WhatsApp con n8n, integrando Meta Business y WhatsApp Business API.",
			"Despliegue de Chatwoot como plataforma de atención al cliente multicanal.",
		] },
]
---

<section class="experience" id="experience">
	<h2 class="section-title">Experience</h2>

	<div class="timeline">
		{companies.map((c, i) => (
			<div class="tl-item" data-i={i} style={{ '--i': i }}>
				<div class="tl-badge">
					<img src={c.logo} alt="" />
				</div>
				<div class="tl-body">
					<div class="tl-head">
						<h3>{c.role}</h3>
						<span class="tl-date">{c.date}</span>
					</div>
					<p class="tl-company">{c.name}</p>
					<ul class="tl-bullets">
						{c.bullets.map(b => <li>{b}</li>)}
					</ul>
				</div>
			</div>
		))}
	</div>
</section>

<style>
	.section-title {
		font-size: 2.8rem;
		text-transform: uppercase;
		letter-spacing: 0.3rem;
		color: var(--primary-color);
		border-bottom: 4px solid var(--primary-color);
		padding-bottom: 0.3rem;
		margin-bottom: 2.5rem;
		width: fit-content;
	}

	.timeline {
		position: relative;
		padding-left: 4rem;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 2rem;
		top: 0;
		bottom: 0;
		width: 3px;
		background: var(--primary-color);
		opacity: 0.3;
	}

	.tl-item {
		position: relative;
		margin-bottom: 2.5rem;
		animation: tlSlideUp 0.5s ease both;
		animation-delay: calc(var(--i) * 0.12s);
	}

	.tl-badge {
		position: absolute;
		left: -4rem;
		top: 0;
		width: 3.2rem;
		height: 3.2rem;
		z-index: 1;
		box-shadow: 4px 4px 0 var(--primary-color);
		overflow: hidden;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.tl-item:hover .tl-badge {
		transform: scale(1.15);
		box-shadow: 8px 8px 0 var(--primary-color);
	}

	.tl-badge::before {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image: var(--grain-url);
		background-repeat: repeat;
		background-position: center;
		background-size: auto;
		pointer-events: none;
		content: '';
		mix-blend-mode: soft-light;
		opacity: 40%;
		z-index: 2;
	}

	.tl-badge::after {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		content: '';
		background-color: var(--secundary-text);
		mix-blend-mode: color;
		z-index: 1;
	}

	.tl-badge img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.tl-body {
		background: var(--third-color);
		padding: 1rem 1.5rem;
		border: 2px solid var(--primary-color);
		box-shadow: 6px 6px 0 var(--primary-color);
	}

	.tl-head {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin-bottom: 0.2rem;
	}

	.tl-head h3 {
		font-size: 1.4rem;
		color: var(--primary-text);
		letter-spacing: 0;
		margin: 0;
	}

	.tl-date {
		font-family: "Rosario", sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--primary-color);
		text-transform: uppercase;
		letter-spacing: 0.1rem;
	}

	.tl-company {
		font-family: "Rosario", sans-serif;
		font-size: 1rem;
		font-weight: 600;
		color: var(--secundary-text);
		margin-bottom: 0.5rem;
	}

	.tl-bullets {
		margin: 0;
		padding-left: 1.2rem;
	}

	.tl-bullets li {
		font-family: "Rosario", sans-serif;
		font-size: 0.9rem;
		margin-bottom: 0.2rem;
		line-height: 1.4;
		color: var(--secundary-text);
	}

	@keyframes tlSlideUp {
		from {
			opacity: 0;
			transform: translateY(2rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tl-item {
			animation: none;
		}
	}

	@media only screen and (min-width: 480px) {
		.section-title {
			font-size: 3.5rem;
		}

		.tl-head h3 {
			font-size: 1.6rem;
		}

		.tl-badge {
			width: 3.6rem;
			height: 3.6rem;
		}

		.timeline {
			padding-left: 4.5rem;
		}

		.tl-badge {
			left: -4.5rem;
		}
	}

	@media only screen and (min-width: 768px) {
		.section-title {
			font-size: 4rem;
		}

		.tl-head {
			flex-direction: row;
			justify-content: space-between;
			align-items: baseline;
		}

		.tl-head h3 {
			font-size: 1.8rem;
		}

		.tl-body {
			padding: 1.2rem 2rem;
		}

		.tl-badge {
			width: 4rem;
			height: 4rem;
		}

		.timeline {
			padding-left: 5rem;
		}

		.tl-badge {
			left: -5rem;
		}
	}
</style>
