---
const { src, alt, transition = "" } = Astro.props;
const baseUrl = ((import.meta as any).env?.BASE_URL || '/').replace(/\/?$/, '/');
const assetSrc = src.startsWith('http') ? src : `${baseUrl}${src.startsWith('/') ? src.slice(1) : src}`;
---

<div class="texture-filter" transition:name={transition} transition:animate="initial">
	<div class="color-filter gradient-background">
		<img class="image" src={assetSrc} alt={alt || ""}>
	</div>
</div>

<style>
	.texture-filter {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.texture-filter::before {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;

		background-image: var(--grain-url);
		background-repeat: repeat;
		background-position: center;
		background-size: auto;

		pointer-events: none;
		content: '';

		mix-blend-mode: soft-light;
		opacity: 40%;
		z-index: 10;
	}

	.color-filter {
		width: 100%;
		height: 100%;

		position: relative;
		object-fit: cover;
	}

	.color-filter::before {
		width: 100%;
		height: 100%;

		pointer-events: none;
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		background-color: var(--secundary-text);
		mix-blend-mode: color;
		z-index: 1;
	}
	.image {
		height: 100%;
		width: 100%;

		object-fit: cover;
	}

</style>
