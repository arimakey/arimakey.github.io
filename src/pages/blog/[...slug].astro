---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TextureFilter from '../../components/TextureFilter.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id.split('/').pop()!.replace('.mdx', '') },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title} description={post.data.description} image={post.data.img}>
	<main class="post">
		<hr>
		<header class="post__header">
			<time class="post__date" datetime={post.data.pubDate.toISOString()}>
				{post.data.pubDate.toLocaleDateString('en-US', {
					year: 'numeric',
					month: 'long',
					day: 'numeric',
				})}
			</time>
			<h1>{post.data.title}</h1>
			<p class="post__description">{post.data.description}</p>
		</header>
		<hr>
		<div class="post__image">
			<TextureFilter src={post.data.img} transition={`post-${post.data.title}`} />
		</div>
		<hr>
		<article class="post__content">
			<Content />
		</article>
		<hr>
		<footer class="post__footer">
			<a href="/" class="large__button large__button--transparent">
				<ion-icon name="arrow-back-outline"></ion-icon>
				Back to Home
			</a>
		</footer>
	</main>
</Layout>

<style>
	.post {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin: 2rem 0rem;
	}

	.post__header {
		text-align: center;
	}

	.post__header h1 {
		font-size: 2rem;
		margin: 1rem 0rem;
	}

	.post__date {
		font-family: "Rosario", sans-serif;
		font-style: italic;
		color: var(--secundary-text);
		font-size: 0.9rem;
	}

	.post__description {
		font-family: "Rosario", sans-serif;
		font-size: 1rem;
		color: var(--secundary-text);
		margin-top: 0.5rem;
	}

	.post__image {
		width: 100%;
		height: 16rem;
		overflow: hidden;
	}

	.post__content {
		font-family: "Rosario", sans-serif;
		line-height: 1.8;
		padding: 0 1rem;
	}

	.post__content :global(h2) {
		font-family: "Nova Round", system-ui;
		font-size: 1.5rem;
		margin: 2rem 0 0.5rem 0;
		padding-bottom: 0.25rem;
		border-bottom: 2px solid var(--primary-color);
	}

	.post__content :global(h3) {
		font-family: "Nova Round", system-ui;
		font-size: 1.2rem;
		margin: 1.5rem 0 0.5rem 0;
		color: var(--primary-text);
		letter-spacing: 0;
	}

	.post__content :global(p) {
		margin-bottom: 1rem;
		font-size: 1rem;
	}

	.post__content :global(ul) {
		margin: 0.5rem 0 1rem 1.5rem;
	}

	.post__content :global(li) {
		margin-bottom: 0.25rem;
	}

	.post__content :global(code) {
		background: var(--third-color);
		padding: 0.15rem 0.4rem;
		font-size: 0.9rem;
	}

	.post__footer {
		display: flex;
		justify-content: center;
		padding-top: 1rem;
	}

	@media only screen and (min-width: 768px) {
		.post__header h1 {
			font-size: 3rem;
		}

		.post__content {
			padding: 0 3rem;
		}

		.post__image {
			height: 24rem;
		}
	}
</style>
