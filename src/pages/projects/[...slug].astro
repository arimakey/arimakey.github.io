---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TextureFilter from '../../components/TextureFilter.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id.split('/').pop()!.replace('.mdx', '') },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<Layout title={project.data.title} description={project.data.description} image={project.data.heroImage}>
	<main class="pd">
		<div class="pd-hero">
			<TextureFilter src={project.data.heroImage} transition={`project-${project.data.title}`} />
		</div>
		<hr>
		<header class="pd-head">
			<h1 class="pd-title">{project.data.title}</h1>
			<p class="pd-deck">{project.data.description}</p>
			<time class="pd-date" datetime={project.data.pubDate.toISOString()}>
				{project.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
			</time>
		</header>
		<hr>
		{
			project.data.tags && project.data.tags.length > 0 && (
				<div class="pd-tags">
					{project.data.tags.map((tag: string) => <span class="pd-tag">{tag}</span>)}
				</div>
			)
		}
		{
			project.data.link && (
				<a href={project.data.link} class="pd-link" target="_blank">
					View Project <ion-icon name="arrow-forward-outline"></ion-icon>
				</a>
			)
		}
		<hr>
		<article class="pd-article">
			<Content />
		</article>
		<hr>
		<a href="/" class="pd-back">
			<ion-icon name="arrow-back-outline"></ion-icon> Back to Home
		</a>
	</main>
</Layout>

<style>
	.pd {
		margin: 2rem 0 4rem;
	}

	.pd-hero {
		width: 100%;
		height: 16rem;
		overflow: hidden;
		border: 3px solid var(--primary-color);
	}

	.pd-head {
		margin: 1.5rem 0;
	}

	.pd-title {
		font-size: 2.4rem;
		font-weight: 900;
		line-height: 1.05;
		margin: 0 0 0.5rem;
		text-transform: uppercase;
		letter-spacing: 0.04rem;
	}

	.pd-deck {
		font-family: "Rosario", sans-serif;
		font-size: 1.1rem;
		color: var(--secundary-text);
		margin: 0 0 0.75rem;
		line-height: 1.4;
	}

	.pd-date {
		font-family: "Rosario", sans-serif;
		font-style: italic;
		font-size: 0.85rem;
		color: var(--secundary-text);
	}

	.pd-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 0.75rem;
	}

	.pd-tag {
		background: var(--primary-color);
		color: var(--contrast-text);
		padding: 0.2rem 0.6rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.06rem;
	}

	.pd-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--primary-color);
		text-transform: uppercase;
		letter-spacing: 0.06rem;
		border-bottom: 2px solid var(--primary-color);
		padding-bottom: 0.25rem;
		margin-bottom: 0.5rem;
	}

	.pd-link:hover {
		opacity: 0.7;
	}

	.pd-article {
		font-family: "Rosario", sans-serif;
		line-height: 1.75;
	}

	.pd-article :global(h2) {
		font-family: "Nova Round", system-ui;
		font-size: 1.4rem;
		margin: 2.5rem 0 0.4rem;
		padding-bottom: 0.25rem;
		border-bottom: 2px solid var(--primary-color);
		text-transform: uppercase;
		letter-spacing: 0.06rem;
	}

	.pd-article :global(h2:first-of-type) {
		margin-top: 0;
	}

	.pd-article :global(p) {
		margin-bottom: 1rem;
		font-size: 1rem;
	}

	.pd-article :global(p:first-of-type)::first-letter {
		float: left;
		font-family: "Nova Round", system-ui;
		font-size: 3.5rem;
		font-weight: 900;
		line-height: 0.8;
		margin: 0.1rem 0.5rem 0 0;
	}

	.pd-article :global(ul) {
		margin: 0.5rem 0 1rem 1.5rem;
	}

	.pd-article :global(li) {
		margin-bottom: 0.35rem;
	}

	.pd-back {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--secundary-text);
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}

	.pd-back:hover {
		color: var(--primary-color);
	}

	@media only screen and (min-width: 600px) {
		.pd-title {
			font-size: 3.5rem;
		}

		.pd-hero {
			height: 20rem;
		}

		.pd-article :global(p:first-of-type)::first-letter {
			font-size: 4.5rem;
		}
	}

	@media only screen and (min-width: 768px) {
		.pd-title {
			font-size: 4.5rem;
		}

		.pd-hero {
			height: 28rem;
		}
	}

	@media only screen and (min-width: 960px) {
		.pd-title {
			font-size: 5.5rem;
		}

		.pd-deck {
			font-size: 1.25rem;
		}
	}
</style>
