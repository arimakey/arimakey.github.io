---
import Layout from '../layouts/Layout.astro';
import { CONTACT_INFO } from '../consts';
---

<Layout title="About Me — Martin Robles" description="Full Stack Developer — About Me">
	<main class="about">
		<hr>
		<header class="about__header">
			<h1>About Me</h1>
			<div class="about__header__line"></div>
		</header>
		<hr>

		<section class="about__bio">
			<p>
				Full Stack Developer con experiencia en el desarrollo de aplicaciones web y plataformas SaaS,
				utilizando tecnologias como <strong>React, Vue.js, Node.js, TypeScript y PostgreSQL</strong>.
				He participado en proyectos de inteligencia artificial, integrando modelos de lenguaje (LLMs),
				automatizacion y APIs para crear soluciones escalables.
			</p>
			<p>
				Disfruto construir productos desde cero, colaborar en equipos multidisciplinarios y aprender
				nuevas tecnologias que aporten valor al negocio. Actualmente radicado en <strong>Trujillo, Peru</strong>,
				trabajando como Full Stack Developer en RapidBoard.
			</p>
		</section>

		<hr>

		<section class="about__education">
			<h2 class="section__title">Education</h2>
			<article class="about__item">
				<div class="about__item__header">
					<h3>Ingenieria de Sistemas</h3>
					<span class="about__item__date">2022 &mdash; 2026</span>
				</div>
				<p>Universidad Nacional de Trujillo</p>
			</article>
		</section>

		<hr>

		<section class="about__certifications">
			<h2 class="section__title">Certifications</h2>
			<div class="about__certs__grid">
				<div class="about__cert">Vue.js</div>
				<div class="about__cert">JavaScript & TypeScript</div>
				<div class="about__cert">Jira</div>
				<div class="about__cert">Git</div>
				<div class="about__cert">Domain-Driven Design</div>
				<div class="about__cert">SOLID</div>
			</div>
		</section>

		<hr>

		<section class="about__contact">
			<h2 class="section__title">Contact</h2>
			<div class="about__contact__links">
				<a href={`mailto:${CONTACT_INFO.email}`} class="large__button">
					<ion-icon name="mail-outline"></ion-icon>
					{CONTACT_INFO.email}
				</a>
				<a href={CONTACT_INFO.linkedin} class="large__button large__button--transparent" target="_blank">
					<ion-icon name="logo-linkedin"></ion-icon>
					LinkedIn
				</a>
				<a href={CONTACT_INFO.github} class="large__button large__button--transparent" target="_blank">
					<ion-icon name="logo-github"></ion-icon>
					GitHub
				</a>
			</div>
		</section>

		<hr>
		<footer class="about__footer">
			<a href="/" class="large__button large__button--transparent">
				<ion-icon name="arrow-back-outline"></ion-icon>
				Back to Home
			</a>
		</footer>
	</main>
</Layout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		margin: 2rem 0rem;
	}

	.about__header h1 {
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: 0.5rem;
	}

	.section__title {
		font-size: 1.2rem;
		color: var(--contrast-text);
		background-color: var(--primary-color);
		text-align: center;
		padding: 0.5rem 1rem;
		margin-bottom: 1rem;
	}

	.about__bio {
		font-family: "Rosario", sans-serif;
		line-height: 1.8;
		padding: 0 1rem;
	}

	.about__bio p {
		font-size: 1rem;
		margin-bottom: 1rem;
	}

	.about__item {
		padding: 0.5rem 1rem;
		border-left: 3px solid var(--primary-color);
		margin-bottom: 1rem;
	}

	.about__item__header {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-bottom: 0.25rem;
	}

	.about__item__header h3 {
		font-size: 1.1rem;
		color: var(--primary-text);
		letter-spacing: 0;
	}

	.about__item__date {
		font-family: "Rosario", sans-serif;
		font-style: italic;
		color: var(--secundary-text);
		font-size: 0.8rem;
	}

	.about__certs__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
		padding: 0 1rem;
	}

	.about__cert {
		border: 2px solid var(--primary-color);
		padding: 0.5rem;
		text-align: center;
		font-family: "Rosario", sans-serif;
		font-size: 0.85rem;
		transition: background-color 0.2s;
	}

	.about__cert:hover {
		background-color: var(--third-color);
	}

	.about__contact__links {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 0 1rem;
	}

	.about__footer {
		display: flex;
		justify-content: center;
		padding-top: 0;
	}

	@media only screen and (min-width: 768px) {
		.about__header h1 {
			font-size: 3.5rem;
		}

		.about__certs__grid {
			grid-template-columns: 1fr 1fr 1fr;
		}

		.about__contact__links {
			flex-direction: row;
		}

		.about__item__header {
			flex-direction: row;
			justify-content: space-between;
			align-items: baseline;
		}
	}
</style>
